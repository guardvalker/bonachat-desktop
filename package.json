{
  "name": "bonachat-desktop",
  "productName": "BonaChat",
  "version": "1.6.0",
  "description": "Cliente de escritorio de BonaChat",
  "main": "main.js",
  "author": "guardvalker",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.guardvalker.bonachat.desktop",
    "productName": "BonaChat",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "build/tray.png"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Network",
      "icon": "build/icon.png"
    },
    "artifactName": "BonaChat-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@45.2.2": true
  }
}